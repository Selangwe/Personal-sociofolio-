# Copy to .env.local (gitignored) and fill in from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# The same three values must also be set in Vercel:
#   Project -> Settings -> Environment Variables
#
# NEXT_PUBLIC_* values are inlined at build time, so changing them in Vercel
# requires a redeploy before they take effect.

# Project URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose — it ships in the browser bundle
# by design. Permissions come from the row-level policies in
# supabase/schema.sql, not from keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. SECRET. It bypasses every row-level policy.
# Never prefix it with NEXT_PUBLIC_, never import it into a component. It is
# read only by lib/leads.ts, lib/chat/rate-limit.ts and scripts/seed-posts.ts.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Read by lib/site-config.ts, which feeds
# sitemap.ts, robots.ts, the page metadata, and the chat assistant's grounding.
# Defaults to the Vercel URL. Set this to the custom domain once its DNS
# resolves — that is the whole cutover.
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# Chat assistant
# ---------------------------------------------------------------------------

# SECRET. Without it /api/chat returns 503 and the widget stays hidden, which
# is the intended behaviour if you are not running the assistant.
ANTHROPIC_API_KEY=

# SECRET. Salt for hashing visitor IPs before they reach the database, so the
# rate-limit table is a ledger rather than a log of who visited. Any long random
# string. Changing it resets everyone's rate-limit counters.
CHAT_IP_SALT=

# Spend controls. All optional — the defaults in lib/chat/config.ts apply if
# unset. CHAT_MONTHLY_CAP is the stop-loss: when it trips the widget stops
# calling the API and points visitors at the contact form instead.
#   CHAT_IP_HOURLY_CAP   default 8
#   CHAT_IP_DAILY_CAP    default 30
#   CHAT_MONTHLY_CAP     default 1500  (~$20/month)
CHAT_IP_HOURLY_CAP=
CHAT_IP_DAILY_CAP=
CHAT_MONTHLY_CAP=
