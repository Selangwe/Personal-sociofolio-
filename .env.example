# Copy to .env.local (gitignored) and fill in from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# The same three values must also be set in Vercel:
#   Project -> Settings -> Environment Variables
#
# NEXT_PUBLIC_* values are inlined at build time, so changing them in Vercel
# requires a redeploy before they take effect.

# Project URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose — it ships in the browser bundle
# by design. Permissions come from the row-level policies in
# supabase/schema.sql, not from keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" key. SECRET. It bypasses every row-level policy.
# Never prefix it with NEXT_PUBLIC_, never import it into a component. It is
# read only by app/api/lead/route.ts and scripts/seed-posts.ts.
SUPABASE_SERVICE_ROLE_KEY=
