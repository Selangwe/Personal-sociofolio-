# Supabase — powers post likes and comments.
# Get these from your Supabase project: Dashboard -> Project Settings -> API.
# Copy this file to .env.local and fill in your values. Never commit .env.local.
#
# If these are left unset, the site still builds and runs; likes fall back to a
# local-only toggle and the comment box shows a "not connected yet" note.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New-style publishable key (starts with "sb_publishable_"). The legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted if that's what your project shows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
